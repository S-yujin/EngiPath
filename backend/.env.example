# Engipath backend environment (handoff §30).
# Copy this file to `.env` and fill in your own values. Never commit `.env`.

# --- LLM ---
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Set to false to disable LLM calls entirely (deterministic fallbacks only).
LLM_ENABLED=true
LLM_MAX_RETRIES=2

# --- Storage ---
DATABASE_PATH=./engipath.db

# --- O*NET data ---
ONET_DATA_PATH=./app/data/processed/occupations.jsonl
ONET_RAW_DIR=./app/data/raw

# --- Question flow ---
MAX_CORE_QUESTIONS=5
MAX_FOLLOW_UP_QUESTIONS=4
MAX_SHORT_TERM_ACTIONS=3

# --- Frontend CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Misc ---
DEBUG=false
