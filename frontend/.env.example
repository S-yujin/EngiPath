# Local or DHub backend for the Vite development proxy.
VITE_BACKEND_URL=http://127.0.0.1:8000
# /api is recommended with npm run dev. For static frontend hosting set this
# to https://YOUR-VM.apps.dauai.org (no trailing /api).
VITE_API_BASE_URL=/api
# true only when explicitly demonstrating with fake data offline.
VITE_DEMO_MODE=false
