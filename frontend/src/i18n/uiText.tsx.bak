export function translateUi(text: string, language: string): string {
  return language === 'ko' ? (KOREAN_UI[text] || localizeKnownCareerText(text, language)) : text;
}
export const LocalizedText: React.FC<{ en: string }> = ({en}) => {
  const {language} = useApp();
  return <>{translateUi(en, language)}</>;
};
// For unmounted native attributes. All translated components also consume AppContext.
export function uiAttr(text: string): string { return translateUi(text, getUiLanguage()); }
