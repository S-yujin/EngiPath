import { LocalizedText, uiAttr } from '../../i18n/uiText';
import React, { useState } from 'react';
import { ReflectionItem, ReflectionPortrait, UserFeedbackState } from '../../types';
import { BadgeVariant } from '../common/Badge';
import { AgreementButtons } from './AgreementButtons';
import { COMPETENCY_LABELS } from '../../utils/scoring';
import {
  CheckCircle2,
  HelpCircle,
  AlertTriangle,
  Flame,
  Info,
  ChevronDown,
  ChevronUp,
  Sparkles,
  Target,
  Compass,
  TrendingUp
} from 'lucide-react';
import { motion, AnimatePresence } from 'framer-motion';

interface CategoryGroupCardProps {
  categoryKey: keyof ReflectionPortrait;
  categoryTitle: string;
  categoryDescription: string;
  items: ReflectionItem[];
  icon: React.ReactNode;
  onFeedbackChange: (itemIndex: number, status: UserFeedbackState, note?: string) => void;
}

export const CategoryGroupCard: React.FC<CategoryGroupCardProps> = ({
  categoryKey,
  categoryTitle,
  categoryDescription,
  items,
  icon,
  onFeedbackChange
}) => {
  const [expandedIndices, setExpandedIndices] = useState<Record<number, boolean>>(() => {
    // By default, expand all items in the group
    const initial: Record<number, boolean> = {};
    items.forEach((_, idx) => {
      initial[idx] = true;
    });
    return initial;
  });

  const toggleItem = (idx: number) => {
    setExpandedIndices((prev) => ({
      ...prev,
      [idx]: !prev[idx]
    }));
  };

  const getThemeConfig = (cat: keyof ReflectionPortrait | string) => {
    switch (cat) {
      case 'supported_strengths':
      case 'strengths':
        return {
          badgeVariant: 'strength' as BadgeVariant,
          icon: <CheckCircle2 className="w-4 h-4 text-emerald-600" />,
          categoryTag: 'Verified Anchors',
          cardBorder: 'border-emerald-200/90 shadow-sm',
          topRibbon: 'bg-gradient-to-r from-emerald-500 via-teal-500 to-brand-teal h-2 rounded-t-2xl',
          headerBg: 'bg-emerald-50/50',
          itemCalloutBg: 'bg-emerald-50/80 border-emerald-200/80 text-emerald-950',
          itemCalloutIcon: <CheckCircle2 className="w-3.5 h-3.5 text-emerald-700 flex-shrink-0 mt-0.5" />,
          pillClass: 'bg-emerald-100/90 text-emerald-800 border-emerald-200'
        };
      case 'possible_hidden_strengths':
      case 'overlookedStrengths':
        return {
          badgeVariant: 'overlooked' as BadgeVariant,
          icon: <Sparkles className="w-4 h-4 text-purple-600" />,
          categoryTag: 'Latent Strengths Uncovered',
          cardBorder: 'border-purple-200/90 shadow-sm ring-1 ring-purple-100/80',
          topRibbon: 'bg-gradient-to-r from-purple-600 via-indigo-600 to-brand-navy h-2 rounded-t-2xl',
          headerBg: 'bg-purple-50/40',
          itemCalloutBg: 'bg-purple-50/90 border-purple-200 text-purple-950',
          itemCalloutIcon: <Flame className="w-3.5 h-3.5 text-purple-700 flex-shrink-0 mt-0.5" />,
          pillClass: 'bg-purple-100 text-purple-800 border-purple-200'
        };
      case 'areas_to_validate':
      case 'areasToValidate':
        return {
          badgeVariant: 'validate' as BadgeVariant,
          icon: <Target className="w-4 h-4 text-amber-600" />,
          categoryTag: 'Validation Runways',
          cardBorder: 'border-amber-200/90 shadow-sm',
          topRibbon: 'bg-gradient-to-r from-amber-500 to-orange-500 h-2 rounded-t-2xl',
          headerBg: 'bg-amber-50/40',
          itemCalloutBg: 'bg-amber-50/80 border-amber-200 text-amber-950',
          itemCalloutIcon: <Compass className="w-3.5 h-3.5 text-amber-700 flex-shrink-0 mt-0.5" />,
          pillClass: 'bg-amber-100 text-amber-900 border-amber-200'
        };
      case 'developing_picture':
      case 'developmentAreas':
        return {
          badgeVariant: 'development' as BadgeVariant,
          icon: <TrendingUp className="w-4 h-4 text-blue-600" />,
          categoryTag: 'Capabilities in Progress',
          cardBorder: 'border-blue-200/90 shadow-sm',
          topRibbon: 'bg-gradient-to-r from-blue-500 to-indigo-500 h-2 rounded-t-2xl',
          headerBg: 'bg-blue-50/30',
          itemCalloutBg: 'bg-blue-50/70 border-blue-200 text-blue-950',
          itemCalloutIcon: <TrendingUp className="w-3.5 h-3.5 text-blue-700 flex-shrink-0 mt-0.5" />,
          pillClass: 'bg-blue-100 text-blue-800 border-blue-200'
        };
      case 'still_taking_shape':
      case 'insufficientInfo':
      default:
        return {
          badgeVariant: 'insufficient' as BadgeVariant,
          icon: <Info className="w-4 h-4 text-slate-500" />,
          categoryTag: 'Unobserved Runway',
          cardBorder: 'border-slate-300 border-dashed shadow-none',
          topRibbon: 'bg-slate-300 h-1.5 rounded-t-2xl',
          headerBg: 'bg-slate-50/80',
          itemCalloutBg: 'bg-slate-100/70 border-slate-200 text-slate-700',
          itemCalloutIcon: <Info className="w-3.5 h-3.5 text-slate-500 flex-shrink-0 mt-0.5" />,
          pillClass: 'bg-slate-200/80 text-slate-700 border-slate-300'
        };
    }
  };

  const theme = getThemeConfig(categoryKey);

  if (!items || items.length === 0) return null;

  return (
    <div
      className={`bg-white rounded-2xl border transition-all duration-200 flex flex-col overflow-hidden ${theme.cardBorder}`}
    >
      {/* Top Color Accent Ribbon */}
      <div className={theme.topRibbon} />

      {/* Unified Master Category Header */}
      <div className={`p-4 sm:p-5 border-b border-slate-100 ${theme.headerBg} flex items-center justify-between gap-4`}>
        <div className="flex items-center gap-3">
          <div className="w-9 h-9 rounded-xl bg-white border border-slate-200/80 shadow-xs flex items-center justify-center flex-shrink-0">
            {theme.icon}
          </div>
          <div>
            <div className="flex items-center gap-2 flex-wrap">
              <h3 className="text-base sm:text-lg font-black text-brand-navy tracking-tight">
                {categoryTitle}
              </h3>
              <span className="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-white border border-slate-200 text-slate-600 shadow-xs">
                {items.length} {items.length === 1 ? 'Capability' : 'Capabilities'}
              </span>
            </div>
            <p className="text-xs text-slate-500 font-medium">
              {categoryDescription}
            </p>
          </div>
        </div>
      </div>

      {/* Unified Inner Items List */}
      <div className="divide-y divide-slate-100">
        {items.map((item, idx) => {
          const isExpanded = expandedIndices[idx] ?? true;

          return (
            <div key={idx} className="p-4 sm:p-5 transition-colors hover:bg-slate-50/40 space-y-3">
              {/* Item Header Row */}
              <div className="flex items-start justify-between gap-3">
                <div className="flex-1 space-y-1">
                  <div className="flex flex-wrap items-center gap-2">
                    <h4 className="text-base font-bold text-slate-900 leading-snug">
                      {item.label}
                    </h4>
                    <span className="text-[11px] font-semibold text-slate-600 bg-slate-100 px-2 py-0.5 rounded-md border border-slate-200/70">
                      {COMPETENCY_LABELS[item.competency] || item.competency}
                    </span>
                  </div>
                </div>

                <button
                  onClick={() => toggleItem(idx)}
                  className="text-slate-400 hover:text-slate-600 p-1.5 rounded-lg hover:bg-slate-100 transition-colors cursor-pointer flex-shrink-0"
                  title={isExpanded ? 'Collapse' : 'Expand'}
                >
                  {isExpanded ? <ChevronUp className="w-4 h-4" /> : <ChevronDown className="w-4 h-4" />}
                </button>
              </div>

              {/* Collapsible Item Details */}
              <AnimatePresence initial={false}>
                {isExpanded && (
                  <motion.div
                    initial={{ opacity: 0, height: 0 }}
                    animate={{ opacity: 1, height: 'auto' }}
                    exit={{ opacity: 0, height: 0 }}
                    transition={{ duration: 0.2 }}
                    className="space-y-3 pt-1"
                  >
                    {/* Mentor Explanation Callout */}
                    <div className={`flex items-start gap-2.5 p-3.5 rounded-xl border text-xs sm:text-sm leading-relaxed ${theme.itemCalloutBg}`}>
                      {theme.itemCalloutIcon}
                      <div>
                        <span className="font-bold"><LocalizedText en={"Why this insight:"} />{' '}</span>
                        <span>{item.explanation || item.evidence}</span>
                      </div>
                    </div>

                    {/* Observed Evidence Code Badges */}
                    {item.supporting_sources && item.supporting_sources.length > 0 && (
                      <div className="flex flex-wrap items-center gap-1.5 text-xs text-slate-500">
                        <span className="font-bold text-slate-700"><LocalizedText en={"Observed Evidence:"} /></span>
                        {item.supporting_sources.map((src, sIdx) => (
                          <span
                            key={sIdx}
                            className={`px-2 py-0.5 rounded-md font-mono text-[11px] font-bold border ${theme.pillClass}`}
                          >
                            {src}
                          </span>
                        ))}
                      </div>
                    )}

                    {/* User Context Note if exists */}
                    {item.userContextNote && (
                      <div className="text-xs sm:text-sm bg-blue-50/80 border border-blue-200 p-3 rounded-xl text-blue-950 font-medium">
                        <span className="font-bold text-blue-900"><LocalizedText en={"Your Added Context:"} />{' '}</span>
                        {item.userContextNote}
                      </div>
                    )}

                    {/* Interactive Feedback Buttons */}
                    <div className="pt-1">
                      <AgreementButtons
                        initialState={item.userFeedback}
                        initialNote={item.userContextNote}
                        onFeedbackChange={(status, note) => onFeedbackChange(idx, status, note)}
                      />
                    </div>
                  </motion.div>
                )}
              </AnimatePresence>
            </div>
          );
        })}
      </div>
    </div>
  );
};
