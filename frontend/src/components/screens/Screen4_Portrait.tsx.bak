import { LocalizedText, uiAttr } from '../../i18n/uiText';
import React, { useState } from 'react';
import { useApp } from '../../context/AppContext';
import { CategoryGroupCard } from '../feedback/CategoryGroupCard';
import { RadarChart } from '../common/RadarChart';
import { ConfidenceScore } from '../common/ConfidenceScore';
import { NewCycleModal } from '../common/NewCycleModal';
import { ReflectionPortrait, ReflectionItem } from '../../types';
import {
  Sparkles,
  ArrowRight,
  ArrowLeft,
  Flame,
  CheckCircle2,
  AlertTriangle,
  Compass,
  RefreshCw,
  Loader2,
  RotateCw,
  TrendingUp,
  Info,
  Check
} from 'lucide-react';
import { motion, AnimatePresence } from 'framer-motion';

export const Screen4_Portrait: React.FC = () => {
  const {
    portrait,
    portraitStatus,
    portraitError,
    generatePortrait,
    setPortraitFeedback,
    currentScores,
    previousScores,
    scoreDeltas,
    evolutionSummary,
    currentCycle,
    selectedJob,
    setCurrentStep
  } = useApp();

  const [activeCategoryFilter, setActiveCategoryFilter] = useState<string>('all');
  const [isNewCycleModalOpen, setIsNewCycleModalOpen] = useState<boolean>(false);

  // Build the real portrait from the questionnaire's calibrated profile on
  // first entry. Demo mode (no backend student) keeps the mock portrait.
  React.useEffect(() => {
    generatePortrait();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  const categories: Array<{
    key: keyof ReflectionPortrait;
    legacyKey?: string;
    title: string;
    description: string;
    icon: React.ReactNode;
    color: string;
  }> = [
      {
        key: 'supported_strengths',
        legacyKey: 'strengths',
        title: 'Confirmed Core Anchors',
        description: 'Strengths with high confidence supported by demonstrated behavioral evidence across your reflections.',
        icon: <CheckCircle2 className="w-4 h-4 text-emerald-600" />,
        color: 'text-emerald-700 bg-emerald-50 border-emerald-200'
      },
      {
        key: 'possible_hidden_strengths',
        legacyKey: 'overlookedStrengths',
        title: 'Possible Hidden Strengths',
        description: 'Capabilities where your scenario actions demonstrate higher competence than your cautious self-description.',
        icon: <Flame className="w-4 h-4 text-purple-600" />,
        color: 'text-purple-700 bg-purple-50 border-purple-200'
      },
      {
        key: 'areas_to_validate',
        legacyKey: 'areasToValidate',
        title: 'Enthusiastic Areas to Validate',
        description: 'Domains where your confidence is high and you are primed to validate through upcoming project milestones.',
        icon: <Sparkles className="w-4 h-4 text-amber-600" />,
        color: 'text-amber-800 bg-amber-50 border-amber-200'
      },
      {
        key: 'developing_picture',
        legacyKey: 'developmentAreas',
        title: 'Developing Picture',
        description: 'Capabilities where initial experience is emerging and will continue to crystallize with further hands-on challenges.',
        icon: <Compass className="w-4 h-4 text-blue-600" />,
        color: 'text-blue-700 bg-blue-50 border-blue-200'
      },
      {
        key: 'still_taking_shape',
        legacyKey: 'insufficientInfo',
        title: 'Still Taking Shape',
        description: 'Open growth frontiers with minimal direct evidence so far — representing your upcoming runway for learning.',
        icon: <AlertTriangle className="w-4 h-4 text-slate-600" />,
        color: 'text-slate-700 bg-slate-100 border-slate-300'
      }
    ];

  return (
    <div className="w-full max-w-[1600px] mx-auto px-5 sm:px-8 lg:px-12 pb-12 space-y-8 animate-fadeIn box-border">
      {/* New Reflection Cycle Check-in Modal */}
      <NewCycleModal
        isOpen={isNewCycleModalOpen}
        onClose={() => setIsNewCycleModalOpen(false)}
      />

      {/* Screen Header */}
      <div className="text-center space-y-2 relative">
        <div className="flex items-center justify-center gap-2">
          <div className="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-bold shadow-sm">
            <Sparkles className="w-4 h-4 text-emerald-600" />
            <span><LocalizedText en={"Step 4 • Explainable Reflection Portrait"} /></span>
          </div>

          <span className="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-slate-900 text-teal-300 text-xs font-extrabold border border-teal-500/30">
            <LocalizedText en={"Cycle"} />{' '}{currentCycle} {currentCycle > 1 ? '• Evolved' : '• Baseline'}
          </span>
        </div>

        <h2 className="text-3xl font-extrabold text-brand-navy tracking-tight">
          <LocalizedText en={"Your Engineering Growth Portrait"} />{' '}</h2>
        <p className="text-slate-600 text-sm max-w-2xl mx-auto">
          {portrait.summary_narration || (
            <>
              <LocalizedText en={"Here is an explainable breakdown of your strengths, blindspots, and critical growth vectors compared to"} />{' '}
              <strong className="text-brand-navy underline decoration-brand-gold">
                {selectedJob?.title || 'your target role'}
              </strong>.
            </>
          )}
        </p>
      </div>

      <div className="grid grid-cols-1 xl:grid-cols-12 gap-6 xl:gap-8 items-start">
        {/* Left Column: Categorized Reflection Cards (7 cols) */}
        <div className="xl:col-span-7 min-w-0 space-y-6">
          {/* Live AI Synthesis Generating Banner */}
          {portraitStatus === 'generating' && (
            <div className="rounded-2xl p-4 bg-teal-500/10 border border-teal-500/30 text-teal-900 flex items-center justify-between gap-3 animate-pulse">
              <div className="flex items-center gap-3">
                <Loader2 className="w-5 h-5 text-teal-600 animate-spin flex-shrink-0" />
                <div>
                  <p className="text-xs font-extrabold text-teal-950"><LocalizedText en={"Synthesizing Explainable Growth Portrait..."} /></p>
                  <p className="text-[11px] text-teal-800"><LocalizedText en={"Calibrating your 10 diagnostic reflection responses with Engipath AI"} /></p>
                </div>
              </div>
              <span className="text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-teal-200/60 text-teal-950 flex-shrink-0">
                <LocalizedText en={"Live AI Synthesis"} />{' '}</span>
            </div>
          )}

          {/* Executive Summary Hero Card */}
          <div className="bg-gradient-to-br from-brand-navy via-brand-navyLight to-slate-900 text-white rounded-3xl p-6 sm:p-7 shadow-xl space-y-4 border border-brand-navyLight/40">
            <div className="flex items-center justify-between gap-3 border-b border-white/10 pb-3 flex-wrap">
              <div className="flex items-center gap-2.5">
                <div className="w-8 h-8 rounded-xl bg-brand-gold/20 border border-brand-gold/40 flex items-center justify-center text-brand-gold">
                  <Sparkles className="w-4 h-4" />
                </div>
                <div>
                  <h3 className="text-base font-extrabold tracking-tight"><LocalizedText en={"Growth Portrait Executive Synthesis"} /></h3>
                  <p className="text-xs text-slate-300"><LocalizedText en={"Calibrated against"} />{' '}{selectedJob?.title || 'Target Role'}</p>
                </div>
              </div>

              <div className="flex items-center gap-2 flex-wrap">
                <button
                  type="button"
                  onClick={() => generatePortrait(true)}
                  disabled={portraitStatus === 'generating'}
                  className="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/10 hover:bg-white/20 text-slate-200 hover:text-white text-xs font-bold border border-white/15 transition-all cursor-pointer disabled:opacity-50"
                  title={uiAttr("Regenerate explainable portrait with Engipath AI")}
                >
                  <RefreshCw className={`w-3.5 h-3.5 ${portraitStatus === 'generating' ? 'animate-spin' : ''}`} />
                  <span><LocalizedText en={"Regenerate with AI"} /></span>
                </button>

                {/* Re-Reflect Cycle Button */}
                <button
                  onClick={() => setIsNewCycleModalOpen(true)}
                  className="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-teal-500/20 hover:bg-teal-500/30 text-teal-300 border border-teal-500/40 text-xs font-bold transition-all shadow-sm cursor-pointer"
                >
                  <RotateCw className="w-3.5 h-3.5" />
                  <span><LocalizedText en={"Reflect on Recent Progress (Cycle"} />{' '}{currentCycle + 1})</span>
                </button>
              </div>
            </div>

            <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
              <div className="p-3 rounded-2xl bg-white/5 border border-white/10 space-y-1">
                <span className="text-[10px] font-bold uppercase tracking-wider text-emerald-400 flex items-center gap-1">
                  <CheckCircle2 className="w-3 h-3" /> <LocalizedText en={"Core Anchor"} />{' '}</span>
                <p className="font-bold text-white text-sm">
                  {portrait.supported_strengths?.[0]?.label || 'Solid Problem Framing & Troubleshooting'}
                </p>
                <p className="text-slate-300 text-[11px] line-clamp-2">
                  {portrait.supported_strengths?.[0]?.explanation || 'Demonstrated dependable engineering fundamentals in scenario diagnostics.'}
                </p>
              </div>

              <div className="p-3 rounded-2xl bg-white/5 border border-white/10 space-y-1">
                <span className="text-[10px] font-bold uppercase tracking-wider text-purple-300 flex items-center gap-1">
                  <Flame className="w-3 h-3" /> <LocalizedText en={"Hidden Growth Lever"} />{' '}</span>
                <p className="font-bold text-white text-sm">
                  {portrait.possible_hidden_strengths?.[0]?.label || portrait.developing_picture?.[0]?.label || 'Adaptive Strategy & Execution'}
                </p>
                <p className="text-slate-300 text-[11px] line-clamp-2">
                  {portrait.possible_hidden_strengths?.[0]?.explanation || portrait.developing_picture?.[0]?.explanation || 'Demonstrated capability indicates readiness to tackle real-world project complexity.'}
                </p>
              </div>
            </div>

            <p className="text-xs text-slate-200/90 leading-relaxed italic bg-white/5 p-3 rounded-xl border border-white/5">
              "{portrait.summary_narration || 'Your diagnostic confirms strong analytical foundations with an open runway in physical prototyping and systems integration.'}"
            </p>
          </div>

          {/* Longitudinal Growth Evolution Card (Rendered if multi-cycle deltas exist) */}
          {(currentCycle > 1 || evolutionSummary || scoreDeltas) && (
            <motion.div
              initial={{ opacity: 0, y: 8 }}
              animate={{ opacity: 1, y: 0 }}
              className="bg-gradient-to-br from-teal-950/60 via-slate-900 to-indigo-950/60 border border-teal-500/30 rounded-3xl p-5 text-white shadow-xl space-y-3"
            >
              <div className="flex items-center justify-between gap-2 border-b border-white/10 pb-2.5">
                <div className="flex items-center gap-2">
                  <div className="w-6 h-6 rounded-lg bg-teal-400/20 border border-teal-400/30 flex items-center justify-center text-teal-300">
                    <TrendingUp className="w-3.5 h-3.5" />
                  </div>
                  <span className="text-xs font-extrabold uppercase tracking-wider text-teal-300">
                    <LocalizedText en={"Longitudinal Growth Synthesis • Cycle"} />{' '}{currentCycle} <LocalizedText en={"Evolution"} />{' '}</span>
                </div>
                <span className="text-[11px] font-bold px-2 py-0.5 rounded-full bg-teal-500/20 text-teal-200 border border-teal-500/30">
                  <LocalizedText en={"Verified Upgrades"} />{' '}</span>
              </div>

              {evolutionSummary && (
                <p className="text-xs text-slate-200 leading-relaxed italic">
                  "{evolutionSummary}"
                </p>
              )}

              {scoreDeltas && Object.keys(scoreDeltas).some((k) => (scoreDeltas[k] || 0) !== 0) && (
                <div className="flex flex-wrap items-center gap-2 pt-1">
                  {Object.entries(scoreDeltas)
                    .filter(([_, delta]) => delta !== 0)
                    .map(([dim, delta]) => (
                      <span
                        key={dim}
                        className={`text-[11px] font-extrabold px-2.5 py-1 rounded-xl border flex items-center gap-1 ${
                          delta > 0
                            ? 'bg-emerald-500/20 text-emerald-300 border-emerald-500/40'
                            : 'bg-amber-500/20 text-amber-300 border-amber-500/40'
                        }`}
                      >
                        <span className="capitalize">{dim.replace(/([A-Z])/g, ' $1').trim()}:</span>
                        <span>{delta > 0 ? `+${delta}` : delta} <LocalizedText en={"pts"} /></span>
                      </span>
                    ))}
                </div>
              )}
            </motion.div>
          )}

          {/* Category Filter Chips */}
          <div className="flex flex-wrap items-center gap-2 pb-1">
            <button
              onClick={() => setActiveCategoryFilter('all')}
              className={`flex-shrink-0 px-3.5 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer ${activeCategoryFilter === 'all'
                ? 'bg-brand-navy text-white shadow-sm ring-2 ring-brand-navy/20'
                : 'bg-white text-slate-600 hover:bg-slate-100 border border-slate-200'
                }`}
            >
              <LocalizedText en={"All Dimensions"} />{' '}</button>
            {categories.map((cat) => (
              <button
                key={cat.key}
                onClick={() => setActiveCategoryFilter(cat.key)}
                className={`flex-shrink-0 px-3.5 py-2 rounded-xl text-xs font-semibold transition-all flex items-center gap-1.5 cursor-pointer ${activeCategoryFilter === cat.key
                  ? 'bg-brand-navy text-white shadow-sm font-bold ring-2 ring-brand-navy/20'
                  : 'bg-white text-slate-600 hover:bg-slate-100 border border-slate-200'
                  }`}
              >
                {cat.icon}
                <span>{cat.title}</span>
              </button>
            ))}
          </div>

          {/* Portrait generation states (questionnaire-calibrated) */}
          {portraitStatus === 'generating' && (
            <div className="bg-white rounded-2xl p-10 border border-slate-200 shadow-sm flex flex-col items-center justify-center space-y-4 text-center min-h-72">
              <Loader2 className="w-10 h-10 text-brand-teal animate-spin" />
              <h3 className="text-base font-extrabold text-brand-navy">
                <LocalizedText en={"Calibrating your growth portrait…"} />{' '}</h3>
              <p className="text-xs text-slate-500 max-w-sm leading-relaxed">
                <LocalizedText en={"Your questionnaire answers are being weighed across ten capability signals — evidence, self-view and confidence."} />{' '}</p>
            </div>
          )}

          {portraitStatus === 'error' && (
            <div className="bg-red-50 rounded-2xl p-8 border border-red-200 flex flex-col items-center justify-center space-y-4 text-center min-h-72">
              <AlertTriangle className="w-10 h-10 text-red-500" />
              <h3 className="text-base font-extrabold text-red-900"><LocalizedText en={"Portrait generation failed"} /></h3>
              <p className="text-xs text-red-700 max-w-sm">{portraitError}</p>
              <button
                onClick={() => generatePortrait()}
                className="flex items-center gap-1.5 px-5 py-2.5 rounded-xl bg-brand-navy text-white text-xs font-bold hover:bg-brand-navyLight transition-colors"
              >
                <RefreshCw className="w-3.5 h-3.5" />
                <LocalizedText en={"Retry"} />{' '}</button>
            </div>
          )}

          {/* Portrait Sections */}
          {portraitStatus !== 'generating' && portraitStatus !== 'error' && (
            <div className="space-y-6">
              {categories
                .filter((c) => activeCategoryFilter === 'all' || activeCategoryFilter === c.key)
                .map((category) => {
                  const items =
                    portrait[category.key] ||
                    (category.legacyKey ? (portrait as any)[category.legacyKey] : []) ||
                    [];
                  if (!items || items.length === 0) return null;

                  return (
                    <motion.div
                      key={category.key}
                      initial={{ opacity: 0, y: 10 }}
                      animate={{ opacity: 1, y: 0 }}
                      transition={{ duration: 0.25 }}
                    >
                      <CategoryGroupCard
                        categoryKey={category.key}
                        categoryTitle={category.title}
                        categoryDescription={category.description}
                        items={items}
                        icon={category.icon}
                        onFeedbackChange={(itemIdx, status, note) =>
                          setPortraitFeedback(category.key, itemIdx, status, note)
                        }
                      />
                    </motion.div>
                  );
                })}
            </div>
          )}

          {/* Live badge */}
          {portraitStatus === 'live' && (
            <div className="flex items-center gap-1.5 text-[11px] font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 px-3 py-1.5 rounded-full w-fit">
              <Sparkles className="w-3 h-3" />
              <LocalizedText en={"Calibrated live from your questionnaire answers"} />{' '}</div>
          )}

          {/* Navigation Controls */}
          <div className="flex items-center justify-between gap-4 pt-4">
            <button
              onClick={() => setCurrentStep(3)}
              className="flex items-center gap-1.5 px-4 py-2.5 rounded-xl border border-slate-300 text-slate-700 hover:bg-slate-100 text-xs font-bold transition-all cursor-pointer"
            >
              <ArrowLeft className="w-3.5 h-3.5" />
              <span><LocalizedText en={"Back to Reflection"} /></span>
            </button>

            <button
              onClick={() => setCurrentStep(5)}
              className="flex-1 flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r from-brand-navy to-brand-navyLight hover:brightness-110 text-white text-sm font-extrabold shadow-md hover:shadow-lg transition-all cursor-pointer"
            >
              <span><LocalizedText en={"Explore Target Job Match & Action Plan"} /></span>
              <ArrowRight className="w-4 h-4 text-brand-gold" />
            </button>
          </div>
        </div>

        {/* Right Column: Comparative Radar & Gap Analysis (5 cols, sticky floating on scroll with top buffer) */}
        <div className="xl:col-span-5 min-w-0 space-y-6 xl:sticky xl:top-24 self-start transition-all duration-300 ease-out"> 
          <div className="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm space-y-6 hover:shadow-md transition-shadow duration-300">
            <div className="flex items-center justify-between border-b border-slate-100 pb-3">
              <div>
                <h3 className="text-base font-extrabold text-brand-navy">
                  <LocalizedText en={"Competency Gap Overlay"} />{' '}</h3>
                <p className="text-xs text-slate-500">
                  <LocalizedText en={"Current vs Target:"} />{' '}<strong className="text-slate-800">{selectedJob?.title || 'Target Job'}</strong>
                </p>
              </div>
              <span className="text-xs font-bold px-2.5 py-1 rounded-full bg-blue-50 text-blue-800 border border-blue-200">
                <LocalizedText en={"6 Dimensions"} />{' '}</span>
            </div>

            {/* Radar Chart */}
            <div className="h-72">
              <RadarChart
                currentScores={currentScores}
                previousScores={previousScores}
                cycleNumber={currentCycle}
                targetJob={selectedJob}
                height={280}
              />
            </div>

            {/* Confidence & Key Leverage Note */}
            <div className="pt-2 border-t border-slate-100 space-y-3">
              <ConfidenceScore size="compact" showSubtitle={false} />

              <div className="bg-amber-50/80 border border-amber-200 rounded-xl p-3 text-xs space-y-1">
                <span className="font-bold text-amber-900 flex items-center gap-1.5">
                  <Compass className="w-3.5 h-3.5 text-brand-gold" />
                  <LocalizedText en={"Evidence-Aware Calibration:"} />{' '}</span>
                <p className="text-amber-800 text-[11px] leading-relaxed">
                  <LocalizedText en={"Your growth portrait categories are calibrated by comparing what you shared about yourself with concrete project scenarios you described."} />{' '}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
};
